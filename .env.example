PORT=3000
HOST=127.0.0.1
# Set your public HTTPS origin before deployment, with no trailing slash.
PUBLIC_ORIGIN=https://your-college-domain.example
# Set a unique password of at least 14 characters in your hosting secret settings.
ADMIN_PASSWORD=
DATA_DIR=./data
NODE_ENV=production
# Only enable if your trusted reverse proxy replaces X-Forwarded-For.
TRUST_PROXY=0
